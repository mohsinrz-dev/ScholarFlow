{
  "name": "studypilot-backend",
  "version": "1.0.0",
  "description": "StudyPilot AI-powered study planning backend",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "node --input-type=module --eval \"import('./src/app.js').then(() => console.log('Lint OK')).catch(e => { console.error(e); process.exit(1); })\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "node-cron": "^3.0.3",
    "openai": "^4.73.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.5",
    "supertest": "^7.0.0",
    "vitest": "^2.1.5"
  }
}
